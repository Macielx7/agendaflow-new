generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UserRole {
  ADMIN
  STAFF
}

enum SuperAdminRole {
  SUPER_ADMIN
  DEVELOPER
  SUPPORT
}

enum TenantStatus {
  ACTIVE
  PENDING
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PENDING
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum WhatsappConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
}

enum WhatsappMessageType {
  BOOKING
  CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULE
  COMPLETION
  MANUAL
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  FAILED
}

enum WhatsappTemplateType {
  BOOKING
  CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULE
  COMPLETION
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

enum BudgetStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model SuperAdmin {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String
  role      SuperAdminRole @default(SUPER_ADMIN)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  logs      SystemLog[]

  @@map("super_admins")
}

model Plan {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  description       String?
  priceMonthly      Decimal        @default(0) @db.Decimal(10, 2)
  priceYearly       Decimal        @default(0) @db.Decimal(10, 2)
  maxUsers          Int            @default(1)
  maxAppointments   Int            @default(100)
  features          String         @default("[]")
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  subscriptions     Subscription[]
  tenants           Tenant[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("plans")
}

model Tenant {
  id              String              @id @default(cuid())
  slug            String              @unique
  companyName     String
  ownerName       String
  email           String
  phone           String?
  status          TenantStatus        @default(PENDING)
  planId          String?
  plan            Plan?               @relation(fields: [planId], references: [id])
  subscription    Subscription?
  lastAccessAt    DateTime?
  users           User[]
  clients         Client[]
  services        Service[]
  schedules       Schedule[]
  holidays        Holiday[]
  appointments    Appointment[]
  settings        Setting[]
  billingHistory  BillingHistory[]
  featurePermissions FeaturePermission[]
  logs            SystemLog[]
  whatsappInstance WhatsappInstance?
  whatsappSettings WhatsappSettings?
  whatsappTemplates WhatsappTemplate[]
  whatsappMessages WhatsappMessage[]
  whatsappLogs     WhatsappLog[]
  aiSettings       AiSettings?
  knowledgeBase    KnowledgeBase[]
  faqEntries       FaqEntry[]
  conversationContexts ConversationContext[]
  intentLogs       IntentLog[]
  chatSessions     ChatSession[]
  financialCategories   FinancialCategory[]
  financialReceivables  FinancialReceivable[]
  financialPayables       FinancialPayable[]
  financialBudgets        FinancialBudget[]
  financialInstallments   FinancialInstallment[]
  financialCommissionRules FinancialCommissionRule[]
  financialCommissions    FinancialCommission[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([email])
  @@map("tenants")
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String             @unique
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  trialEndsAt  DateTime?
  startsAt     DateTime           @default(now())
  endsAt       DateTime?
  renewedAt    DateTime?
  cancelledAt  DateTime?
  billingCycle String             @default("monthly")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@map("subscriptions")
}

model BillingHistory {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  status      BillingStatus @default(PENDING)
  paidAt      DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())

  @@index([tenantId])
  @@map("billing_history")
}

model FeaturePermission {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    String
  enabled   Boolean  @default(true)
  limit     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, module])
  @@map("feature_permissions")
}

model SystemLog {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  action       String
  details      String?
  ip           String?
  createdAt    DateTime    @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("system_logs")
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String
  password         String
  name             String
  role             UserRole  @default(ADMIN)
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Client {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  cpf          String
  phone        String
  email        String?
  age          Int?
  notes        String?
  appointments          Appointment[]
  financialReceivables  FinancialReceivable[]
  financialBudgets      FinancialBudget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([phone])
  @@index([name])
  @@index([cpf])
  @@map("clients")
}

model Service {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  description  String?
  duration     Int           @default(60)
  price        Decimal       @default(0) @db.Decimal(10, 2)
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("services")
}

model Schedule {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int      @default(60)
  breakStart   String?
  breakEnd     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@map("schedules")
}

model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@map("holidays")
}

model Appointment {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  date      DateTime          @db.Date
  time      String
  duration  Int?
  notes     String?
  status    AppointmentStatus @default(PENDING)
  price     Decimal?          @db.Decimal(10, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, date, time])
  @@index([tenantId])
  @@index([status])
  @@index([date])
  @@index([clientId])
  @@map("appointments")
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("settings")
}

model WhatsappInstance {
  id              String                   @id @default(cuid())
  tenantId        String                   @unique
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceName    String                   @unique
  status          WhatsappConnectionStatus @default(DISCONNECTED)
  phoneNumber     String?
  profileName     String?
  qrCode          String?                  @db.Text
  qrExpiresAt     DateTime?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  lastEventAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status])
  @@map("whatsapp_instances")
}

model WhatsappSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingsEnabled       Boolean  @default(true)
  confirmationsEnabled  Boolean  @default(true)
  remindersEnabled      Boolean  @default(true)
  cancellationsEnabled  Boolean  @default(true)
  reschedulesEnabled    Boolean  @default(true)
  completionsEnabled    Boolean  @default(true)
  reminderHoursBefore   Int      @default(24)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("whatsapp_settings")
}

model WhatsappTemplate {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      WhatsappTemplateType
  content   String               @db.Text
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([tenantId, type])
  @@map("whatsapp_templates")
}

model WhatsappMessage {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?
  clientPhone   String
  clientName    String?
  type          WhatsappMessageType
  content       String                @db.Text
  status        WhatsappMessageStatus @default(PENDING)
  errorMessage  String?
  externalId    String?
  sentAt        DateTime?
  createdAt     DateTime              @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

model WhatsappLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     String
  payload   String?  @db.Text
  level     String   @default("info")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("whatsapp_logs")
}

model AiSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(false)
  autoReplyEnabled    Boolean  @default(true)
  allowCancellations  Boolean  @default(false)
  allowReschedules    Boolean  @default(false)
  transferToHuman     Boolean  @default(true)
  confidenceThreshold Float    @default(0.45)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("ai_settings")
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question  String   @db.Text
  answer    String   @db.Text
  keywords  String?  @db.Text
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("knowledge_base")
}

model FaqEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question           String   @db.Text
  answer             String   @db.Text
  normalizedQuestion String   @db.Text
  keywords           String?  @db.Text
  knowledgeId        String?
  isSystem           Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@map("faq_entries")
}

model ConversationContext {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientPhone String
  clientId    String?
  messages    String   @db.Text
  lastIntent  String?
  lastTopic   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, clientPhone])
  @@index([tenantId])
  @@map("conversation_context")
}

model IntentLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientPhone String
  intent      String
  confidence  Float
  message     String   @db.Text
  response    String?  @db.Text
  matched     Boolean  @default(false)
  transferred Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("intent_logs")
}

model ChatSession {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientPhone   String
  clientId      String?
  status        String    @default("BOT")
  transferredAt DateTime?
  closedAt      DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, clientPhone])
  @@index([tenantId])
  @@map("chat_sessions")
}

model FinancialCategory {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  type      FinancialCategoryType
  active    Boolean               @default(true)
  isSystem  Boolean               @default(false)
  receivables FinancialReceivable[]
  payables    FinancialPayable[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("financial_categories")
}

model FinancialReceivable {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String
  clientCpf     String?
  description   String
  serviceId     String?
  categoryId    String?
  category      FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  budgetId      String?
  budget        FinancialBudget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  dentistId     String?
  dentistName   String?
  amount        Decimal          @db.Decimal(12, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(12, 2)
  dueDate       DateTime         @db.Date
  paidAt        DateTime?        @db.Date
  paymentMethod PaymentMethod?
  status        FinancialStatus  @default(PENDING)
  notes         String?
  installments  FinancialInstallment[]
  commissions   FinancialCommission[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([clientId])
  @@map("financial_receivables")
}

model FinancialPayable {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description   String
  supplier      String?
  categoryId    String?
  category      FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount        Decimal          @db.Decimal(12, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(12, 2)
  dueDate       DateTime         @db.Date
  paidAt        DateTime?        @db.Date
  paymentMethod PaymentMethod?
  status        FinancialStatus  @default(PENDING)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("financial_payables")
}

model FinancialBudget {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  discount          Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  finalAmount       Decimal        @db.Decimal(12, 2)
  installmentsCount Int            @default(1)
  paymentMethod     PaymentMethod?
  status            BudgetStatus   @default(DRAFT)
  dentistId         String?
  dentistName       String?
  notes             String?
  items             FinancialBudgetItem[]
  installments      FinancialInstallment[]
  receivables       FinancialReceivable[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@map("financial_budgets")
}

model FinancialBudgetItem {
  id          String          @id @default(cuid())
  budgetId    String
  budget      FinancialBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  serviceId   String?
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(12, 2)
  totalPrice  Decimal         @db.Decimal(12, 2)

  @@index([budgetId])
  @@map("financial_budget_items")
}

model FinancialInstallment {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId      String?
  budget        FinancialBudget?    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  receivableId  String?
  receivable    FinancialReceivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  clientId      String?
  clientName    String
  clientCpf     String?
  description   String
  number        Int
  amount        Decimal             @db.Decimal(12, 2)
  dueDate       DateTime            @db.Date
  paidAt        DateTime?           @db.Date
  paymentMethod PaymentMethod?
  status        FinancialStatus     @default(PENDING)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([budgetId])
  @@map("financial_installments")
}

model FinancialCommissionRule {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dentistId   String
  dentistName String
  percentage  Decimal  @db.Decimal(5, 2)
  serviceId   String?
  serviceName String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("financial_commission_rules")
}

model FinancialCommission {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivableId     String?
  receivable       FinancialReceivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  dentistId        String
  dentistName      String
  baseAmount       Decimal             @db.Decimal(12, 2)
  percentage       Decimal             @db.Decimal(5, 2)
  commissionAmount Decimal             @db.Decimal(12, 2)
  referenceMonth   String
  paidAt           DateTime?           @db.Date
  createdAt        DateTime            @default(now())

  @@index([tenantId])
  @@index([referenceMonth])
  @@map("financial_commissions")
}
